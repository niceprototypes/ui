{
  "backgroundColor": {
    "base": "var(--np--overlay-color)"
  },
  "image": {
    "maxWidth": {
      "base": "90vw"
    },
    "maxHeight": {
      "base": "80vh"
    }
  },
  "caption": {
    "maxWidth": {
      "base": "600px"
    },
    "padding": {
      "base": "var(--np--gap) var(--np--gap--large)"
    }
  },
  "focusRing": {
    "width": {
      "base": "var(--np--focus-ring--width)"
    },
    "color": {
      "base": "var(--np--focus-ring--color)"
    },
    "offset": {
      "base": "var(--np--focus-ring--offset)"
    }
  },
  "$themes": {
    "night": {}
  }
}
