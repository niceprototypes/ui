{
  "h1": {
    "before": "calc(var(--np--gap--larger) * 2)",
    "after": "var(--np--gap--larger)"
  },
  "h2": {
    "before": "calc(var(--np--gap--larger) + var(--np--gap--large))",
    "after": "var(--np--gap--larger)"
  },
  "h3": {
    "before": "calc(var(--np--gap--large) * 2)",
    "after": "var(--np--gap--larger)"
  },
  "h4": {
    "before": "var(--np--gap--larger)",
    "after": "var(--np--gap)"
  },
  "h5": {
    "before": "var(--np--gap--large)",
    "after": "var(--np--gap)"
  },
  "h6": {
    "before": "var(--np--gap--large)",
    "after": "var(--np--gap)"
  },
  "text": {
    "before": "var(--np--gap--none)",
    "after": "var(--np--gap--large)"
  },
  "list": {
    "before": "var(--np--gap--none)",
    "after": "var(--np--gap--large)"
  },
  "blockquote": {
    "before": "var(--np--gap--none)",
    "after": "var(--np--gap--large)"
  },
  "table": {
    "before": "var(--np--gap--none)",
    "after": "var(--np--gap--large)"
  },
  "code": {
    "before": "var(--np--gap--none)",
    "after": "var(--np--gap--large)"
  },
  "media": {
    "before": "var(--np--gap--none)",
    "after": "var(--np--gap--large)"
  },
  "block": {
    "before": "var(--np--gap--none)",
    "after": "var(--np--gap--large)"
  },
  "rule": {
    "before": "var(--np--gap--larger)",
    "after": "var(--np--gap--larger)"
  },
  "density": {
    "compact": "0.5",
    "base": "1",
    "spacious": "1.5"
  },
  "scale": {
    "base": "0.5"
  },
  "bleed": {
    "base": "calc(var(--np--gap--small) * 0)"
  },
  "itemBleed": {
    "base": "calc(var(--np--gap--small) * 0)"
  },
  "$breakpoints": {
    "tablet": {
      "scale": {
        "base": "0.75"
      }
    },
    "laptop": {
      "scale": {
        "base": "1"
      }
    }
  }
}
