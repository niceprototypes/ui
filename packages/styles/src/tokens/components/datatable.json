{
  "toolbar": {
    "gap": {
      "base": "var(--np--gap--small)"
    },
    "paddingBlock": {
      "base": "var(--np--gap--small)"
    },
    "paddingInline": {
      "base": "var(--np--gap)"
    },
    "fontSize": {
      "base": "var(--np--font-size)"
    }
  },
  "expander": {
    "color": {
      "base": "var(--np--checkbox--border-color--strong)",
      "hover": "var(--np--checkbox--hover--border-color--strong)"
    },
    "size": {
      "base": "var(--np--checkbox--size--small)"
    },
    "iconSize": {
      "base": "var(--np--checkbox--icon--size--small)"
    },
    "borderWidth": {
      "base": "var(--np--checkbox--border-width)"
    }
  },
  "touchTarget": {
    "base": "24px"
  },
  "focusRing": {
    "width": {
      "base": "var(--np--focus-ring--width)"
    },
    "color": {
      "base": "var(--np--focus-ring--color)"
    }
  },
  "$themes": {
    "night": {}
  }
}
