{
  "padding": {
    "base": "var(--np--gap--smaller)"
  },
  "touchTarget": {
    "base": "24px"
  },
  "item": {
    "gap": {
      "base": "var(--np--gap--small)"
    },
    "paddingBlock": {
      "base": "var(--np--gap--small)"
    },
    "paddingInline": {
      "base": "var(--np--gap)"
    },
    "borderRadius": {
      "base": "var(--np--border-radius--small)"
    },
    "backgroundColor": {
      "focus": "var(--np--border-color)"
    },
    "color": {
      "disabled": "var(--np--color--disabled)"
    }
  },
  "groupLabel": {
    "color": {
      "base": "var(--np--color--lighter)"
    }
  },
  "separator": {
    "color": {
      "base": "var(--np--border-color)"
    },
    "width": {
      "base": "var(--np--border-width)"
    },
    "marginBlock": {
      "base": "var(--np--gap--smaller)"
    }
  },
  "trigger": {
    "borderColor": {
      "base": "var(--np--checkbox--border-color--strong)",
      "hover": "var(--np--checkbox--hover--border-color--strong)"
    }
  },
  "$themes": {
    "night": {}
  }
}
