{
  "message": {
    "maxWidth": {
      "user": "80%",
      "assistant": "100%"
    },
    "padding": {
      "user": "var(--np--gap--small) var(--np--gap)",
      "assistant": "var(--np--gap--none)"
    },
    "borderRadius": {
      "user": "var(--np--border-radius--large)",
      "assistant": "var(--np--border-radius--none)"
    },
    "backgroundColor": {
      "user": "var(--np--background-color--raised)",
      "assistant": "transparent"
    }
  },
  "log": {
    "gap": {
      "base": "var(--np--gap--large)"
    }
  },
  "composer": {
    "maxRows": {
      "base": "6"
    }
  },
  "toolCall": {
    "padding": {
      "base": "var(--np--gap)"
    },
    "gap": {
      "base": "var(--np--gap--small)"
    },
    "borderWidth": {
      "base": "var(--np--border-width)"
    },
    "borderColor": {
      "base": "var(--np--border-color)"
    },
    "borderRadius": {
      "base": "var(--np--border-radius--large)"
    }
  },
  "thinking": {
    "blockSize": {
      "base": "calc(1em * var(--np--line-height))"
    },
    "gap": {
      "base": "var(--np--gap--smaller)"
    },
    "dotSize": {
      "base": "calc(var(--np--size--smaller) / 4)"
    },
    "dotBorderRadius": {
      "base": "50%"
    },
    "dotColor": {
      "base": "var(--np--color--lighter)"
    },
    "dotOpacity": {
      "base": "var(--np--opacity--disabled)"
    },
    "lift": {
      "base": "var(--np--chat--thinking--dot-size)"
    },
    "animationDuration": {
      "base": "var(--np--animation-duration--slower)"
    },
    "animationDelay": {
      "base": "var(--np--animation-duration--fast)"
    },
    "animationEasing": {
      "base": "var(--np--animation-easing)"
    }
  }
}
